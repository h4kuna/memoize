{
  "name": "h4kuna/memoize",
  "description": "Provide cache to memory for your class.",
  "type": "tool",
  "license": "MIT",
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.0.0",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.2 || ^12.0",
    "shipmonk/coding-standard": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\Memoize\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\Memoize\\Tests\\": "tests/src"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "cbf": "vendor/bin/phpcbf",
    "coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit tests/src --coverage-filter src --coverage-html coverage.html",
    "cs": "vendor/bin/phpcs",
    "qa": [
      "@tests",
      "@cs",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/phpunit tests/src"
  }
}
